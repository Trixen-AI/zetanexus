# Reown AppKit project ID (https://dashboard.reown.com). Public identifier; restrict by domain.
VITE_REOWN_PROJECT_ID=

# Optional: ZKRail checkout API base URL (issues shielded ZEC addresses).
VITE_ZKRAIL_API_URL=

# Optional: Robinhood Chain RPC. Defaults to the public endpoint.
VITE_RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
